// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserPlan {
  FREE
  PAID
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum BillingInterval {
  MONTH
  YEAR
}

enum DesignPlacement {
  FRONT
  BACK
  SLEEVE
}

enum DesignStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// Account holder. Registration only requires username + password, matching
/// the current localStorage auth; `plan` is a cached read for gating features
/// like custom uploads — `Subscription` below is the real billing history.
model User {
  id            String    @id @default(uuid())
  username      String    @unique
  passwordHash  String    @map("password_hash")
  email         String?
  plan          UserPlan  @default(FREE)
  planExpiresAt DateTime? @map("plan_expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  subscriptions Subscription[]
  customDesigns CustomDesign[]

  @@map("users")
}

/// Shipping/billing address. Nullable owner so guest checkout can still
/// create one without an account.
model Address {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  fullName   String   @map("full_name")
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String   @map("postal_code")
  country    String
  createdAt  DateTime @default(now()) @map("created_at")

  user           User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  @@index([userId])
  @@map("addresses")
}

/// Full billing history for the paid tier — every renewal, cancellation, and
/// lapse, not just the current state cached on `User.plan`.
model Subscription {
  id               String             @id @default(uuid())
  userId           String             @map("user_id")
  plan             String
  status           SubscriptionStatus
  price            Decimal            @db.Decimal(10, 2)
  currency         String             @default("USD")
  billingInterval  BillingInterval    @map("billing_interval")
  startedAt        DateTime           @map("started_at")
  currentPeriodEnd DateTime           @map("current_period_end")
  canceledAt       DateTime?          @map("canceled_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@map("subscriptions")
}

/// User-uploaded artwork applied onto an existing blank variant. Gating this
/// to paid users is an application-layer rule, not a schema constraint.
model CustomDesign {
  id            String          @id @default(uuid())
  userId        String          @map("user_id")
  baseVariantId String          @map("base_variant_id")
  name          String
  imageUrl      String          @map("image_url")
  placement     DesignPlacement
  status        DesignStatus    @default(DRAFT)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseVariant ProductVariant @relation(fields: [baseVariantId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]

  @@index([userId])
  @@index([baseVariantId])
  @@map("custom_designs")
}

/// One row per tee design. Price/stock live on variants, not here — this row
/// is the shared design metadata.
model Product {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  weightGsm   Int      @map("weight_gsm")
  fit         String
  badge       String?
  rating      Decimal  @default(0) @db.Decimal(2, 1)
  reviewCount Int      @default(0) @map("review_count")
  /// Curated merchandising flag for the homepage Best Sellers rail — not derived from real order data yet.
  isBestSeller Boolean @default(false) @map("is_best_seller")
  /// Mock urgency counter shown on the PDP — no real order data exists behind this yet.
  soldLast24h Int?     @map("sold_last_24h")
  createdAt   DateTime @default(now()) @map("created_at")

  variants ProductVariant[]
  images   ProductImage[]
  reviews  Review[]

  @@map("products")
}

/// One row per color x size combo — the real sellable unit, and where stock
/// actually lives.
model ProductVariant {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  colorName     String   @map("color_name")
  colorHex      String   @map("color_hex")
  size          String
  sku           String   @unique
  priceOverride Decimal? @map("price_override") @db.Decimal(10, 2)
  stockQuantity Int      @default(0) @map("stock_quantity")
  /// Explicit ordering (color, then size) — variant `id` is a UUID and carries no usable order.
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images        ProductImage[]
  orderItems    OrderItem[]
  customDesigns CustomDesign[]

  @@index([productId])
  @@map("product_variants")
}

/// Ordered gallery per product. `variantId` is set only for a color-specific
/// angle shot, otherwise null (shared across colors).
model ProductImage {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  variantId String? @map("variant_id")
  url       String
  altText   String  @map("alt_text")
  position  Int
  isCover   Boolean @default(false) @map("is_cover")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@map("product_images")
}

/// `userId` stays nullable to keep seeded/mock reviews valid without a real
/// author.
model Review {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  userId     String?  @map("user_id")
  /// Display name for reviews with no real account behind them (userId null). When userId is set, prefer the user's username.
  authorName String?  @map("author_name")
  rating     Int
  title      String
  body       String
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

/// `userId` nullable for guest checkout; totals are stored, not recomputed,
/// so past orders stay stable if prices later change.
model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique @map("order_number")
  userId            String?     @map("user_id")
  shippingAddressId String      @map("shipping_address_id")
  billingAddressId  String      @map("billing_address_id")
  status            OrderStatus @default(PENDING)
  subtotal          Decimal     @db.Decimal(10, 2)
  shippingCost      Decimal     @map("shipping_cost") @db.Decimal(10, 2)
  tax               Decimal     @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  currency          String      @default("USD")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingAddress Address     @relation("ShippingAddress", fields: [shippingAddressId], references: [id], onDelete: Restrict)
  billingAddress  Address     @relation("BillingAddress", fields: [billingAddressId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  payments        Payment[]

  @@index([userId])
  @@index([shippingAddressId])
  @@index([billingAddressId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

/// Snapshots name/color/size/price at purchase time. Points at either a
/// stock `variantId` or a `customDesignId` — never both (application-enforced).
model OrderItem {
  id                  String  @id @default(uuid())
  orderId             String  @map("order_id")
  variantId           String? @map("variant_id")
  customDesignId      String? @map("custom_design_id")
  productNameSnapshot String  @map("product_name_snapshot")
  colorSnapshot       String  @map("color_snapshot")
  sizeSnapshot        String  @map("size_snapshot")
  unitPrice           Decimal @map("unit_price") @db.Decimal(10, 2)
  quantity            Int
  lineTotal           Decimal @map("line_total") @db.Decimal(10, 2)

  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  customDesign CustomDesign?   @relation(fields: [customDesignId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

/// Settles either an `orderId` or a `subscriptionId` renewal — one row type
/// covers both money-in events. Separate from `Order` so a retried or
/// partial-refund payment doesn't need a new order row.
model Payment {
  id             String        @id @default(uuid())
  orderId        String?       @map("order_id")
  subscriptionId String?       @map("subscription_id")
  provider       String
  method         String
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD")
  /// Unique so concurrent/retried webhook deliveries for the same Stripe session or PayPal order
  /// can't race past a read-then-write check and create duplicate Orders/Payments.
  transactionRef String?       @unique @map("transaction_ref")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  order        Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([subscriptionId])
  @@map("payments")
}
