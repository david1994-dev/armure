DATABASE_URL="postgresql://postgres:password@localhost:5432/teeworld?schema=public"

# Secret used to HMAC-sign the auth session cookie (lib/session.ts). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# Cloudflare R2 (S3-compatible object storage) — used by scripts/upload-images.ts.
# Create a bucket + API token at https://dash.cloudflare.com/ > R2 > Manage API tokens.
R2_ACCOUNT_ID="replace-with-your-cloudflare-account-id"
R2_ACCESS_KEY_ID="replace-with-your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-your-r2-secret-access-key"
R2_BUCKET_NAME="replace-with-your-bucket-name"
# Public base URL for the bucket (r2.dev dev domain, or your own custom domain bound to it).
R2_PUBLIC_URL="https://replace-with-your-bucket-public-url"
