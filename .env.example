DATABASE_URL="postgresql://postgres:password@localhost:5432/teeworld?schema=public"

# Secret used to HMAC-sign the auth session cookie (lib/session.ts). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# Cloudflare R2 (S3-compatible object storage) — used by scripts/upload-images.ts.
# Create a bucket + API token at https://dash.cloudflare.com/ > R2 > Manage API tokens.
R2_ACCOUNT_ID="replace-with-your-cloudflare-account-id"
R2_ACCESS_KEY_ID="replace-with-your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-your-r2-secret-access-key"
R2_BUCKET_NAME="replace-with-your-bucket-name"
# Public base URL for the bucket (r2.dev dev domain, or your own custom domain bound to it).
R2_PUBLIC_URL="https://replace-with-your-bucket-public-url"

# Stripe (test mode) — used by lib/actions/checkout.ts and the webhook at
# app/api/webhooks/stripe/route.ts. Currently disabled in the UI (no Stripe account set up yet)
# but left wired — flip the Cart page's disabled Stripe button back on once you have keys.
# Get test keys from https://dashboard.stripe.com/test/apikeys.
STRIPE_SECRET_KEY="sk_test_replace-with-your-stripe-secret-key"
# Create with `stripe listen --forward-to localhost:3000/api/webhooks/stripe` for local dev
# (prints a whsec_... value), or from the Dashboard's webhook endpoint settings for production.
STRIPE_WEBHOOK_SECRET="whsec_replace-with-your-webhook-signing-secret"

# PayPal (sandbox) — used by lib/paypal.ts, lib/actions/checkout-paypal.ts, and
# components/cart/PayPalButton.tsx. Create a sandbox app at
# https://developer.paypal.com/dashboard/applications/sandbox to get these values.
# NEXT_PUBLIC_PAYPAL_CLIENT_ID is the same Client ID, just exposed to the browser for the PayPal
# JS SDK button — Next.js only inlines NEXT_PUBLIC_* vars at build time, so restart `pnpm dev`
# (or redeploy) after setting it.
PAYPAL_CLIENT_ID="replace-with-your-paypal-sandbox-client-id"
PAYPAL_CLIENT_SECRET="replace-with-your-paypal-sandbox-client-secret"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="replace-with-your-paypal-sandbox-client-id"
# "sandbox" (default) for testing, "live" once you have a verified live PayPal Business account.
PAYPAL_MODE="sandbox"
# From your sandbox app's "Add Webhook" screen (same dashboard page as above) — point it at
# <your-public-url>/api/webhooks/paypal, subscribe to at least PAYMENT.CAPTURE.COMPLETED and
# PAYMENT.CAPTURE.REFUNDED, then copy the Webhook ID it gives you. PayPal has no local-forwarding
# CLI like Stripe's `stripe listen` — for local dev, expose localhost first (e.g. `ngrok http 3000`)
# and use that ngrok URL as the webhook's target.
PAYPAL_WEBHOOK_ID="replace-with-your-paypal-webhook-id"

# Shared password gating /admin (lib/admin-session.ts) — a single admin, not tied to a User account.
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# Secret used to HMAC-sign the admin session cookie (lib/admin-session.ts). Kept separate from
# SESSION_SECRET so a leak or rotation of one trust boundary doesn't affect the other. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# Zalo Bot API (unrelated side feature: team fund tracking bot, see lib/zalo.ts) — base URL
# verified against a real payload on 2026-08-18, do not switch to bot-api.zapps.me.
ZALO_BOT_API_BASE="https://bot-api.zaloplatforms.com"
# From the BotFather-equivalent Zalo bot creation flow.
ZALO_BOT_TOKEN="replace-with-your-zalo-bot-token"
# Must be the bot's FULL display name including the "Bot" prefix and any spaces (e.g. "Bot Team
# Fun") — lib/zalo.ts's stripMention() cuts the incoming text by this exact string, and Zalo
# requires bot names to start with "Bot".
ZALO_BOT_NAME="replace-with-your-bot-display-name"
# Static token you choose and configure on the Zalo bot's webhook settings — Zalo echoes it back
# in the X-Bot-Api-Secret-Token header on every webhook call, verified with a constant-time
# compare in lib/zalo.ts (same timingSafeEqual idiom as lib/admin-session.ts).
ZALO_BOT_WEBHOOK_SECRET="replace-with-a-random-secret-you-choose"

# Google Sheets (fund ledger source of truth — NOT Postgres, see lib/sheets.ts) — service account
# with Editor access on the target spreadsheet, shared with the service account's email. Sheet
# must have 2 tabs named exactly "Thu" and "Chi" (see lib/fund.ts for the column layout — column E
# on both tabs is a hidden message_id column the bot uses to dedupe Zalo webhook retries, and Thu's
# column F "Số Dư Quỹ" is a Sheets formula the bot never writes to).
GOOGLE_SHEETS_SPREADSHEET_ID="replace-with-the-spreadsheet-id-from-its-url"
# Base64 of the full service-account JSON key file (`base64 -i service-account.json | tr -d '\n'`)
# — decoded and JSON.parsed at runtime in lib/sheets.ts.
GOOGLE_SERVICE_ACCOUNT_JSON="replace-with-base64-encoded-service-account-json"
